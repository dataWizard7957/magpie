# Copy to .env and fill in. Never commit .env.

# Which provider the session agent + grounding check use: meta | glimmer
MAGPIE_PROVIDER=meta

# Meta Model API (dev.meta.ai -> API keys)
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Muse Glimmer on Modal (URL from `modal deploy`, add /v1)
GLIMMER_URL=https://<your-app>.modal.run/v1
MODAL_PROXY_KEY=wk-...
MODAL_PROXY_SECRET=ws-...

# Optional tuning
MAGPIE_MAX_TOKENS=1024
MAGPIE_REASONING=low
# 1 = check every Magpie line against Engram before it is spoken (recommended)
MAGPIE_LIVE_GROUNDING=1
